# ---------------------------------------------------------------
# mcp-sefaz-bpe — configuração (copie para .env e preencha)
# NUNCA versione o .env nem o certificado digital.
# ---------------------------------------------------------------

# Ambiente: 1 = Produção, 2 = Homologação
BPE_TP_AMB=2

# UF do emitente (sigla). Define cUF e o autorizador (SVRS ou próprio)
BPE_UF=RS

# CNPJ do emitente (usado como default em eventos)
BPE_CNPJ_EMITENTE=

# Modo de operação: auto | mock | real
#   auto = real se houver certificado configurado, senão mock/dry-run
BPE_MODO=auto

# Certificado ICP-Brasil A1 (arquivo .pfx/.p12) — fora do repositório!
BPE_CERT_PFX_PATH=./certs/certificado.pfx
BPE_CERT_PFX_SENHA=

# (Opcional) Bundle de CAs ICP-Brasil para validar o servidor da SEFAZ (PEM)
BPE_CA_PATH=

# Timeout das requisições SOAP (ms)
BPE_TIMEOUT_MS=30000

# (Opcional) Sobrescrever URLs dos Web Services (senão usa data/endpoints_uf.json)
BPE_URL_RECEPCAO=
BPE_URL_CONSULTA=
BPE_URL_STATUS=
BPE_URL_EVENTO=
BPE_URL_CONSULTA_CADASTRO=
BPE_URL_QRCODE=

# Fuso horário usado nos campos data/hora (TZD do MOC)
BPE_TZ_OFFSET=-03:00
