{
  "name": "mcp-sefaz-bpe",
  "version": "0.1.0",
  "description": "Servidor MCP para integração, validação, consulta e diagnóstico do BP-e (Modelo 63) junto às SEFAZ/SVRS — MOC BP-e v1.00b",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-sefaz-bpe": "dist/index.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "mcp",
    "bpe",
    "sefaz",
    "svrs",
    "bilhete-de-passagem",
    "dfe"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^18.0.10",
    "fast-xml-parser": "^5.12.1",
    "node-forge": "^1.4.4",
    "qrcode": "^1.5.4",
    "xml-crypto": "^6.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
